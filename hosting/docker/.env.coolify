# ===========================================
# CORE MEMORY - COOLIFY PRODUCTION CONFIG
# ===========================================
# For Coolify deployment with Traefik reverse proxy
#
# SETUP:
# 1. In Coolify, set Base Directory to: /hosting/docker
# 2. Add these variables in Coolify's Environment Variables UI
# 3. Replace PLACEHOLDER_DOMAIN with your Coolify-assigned domain
# 4. Add your OPENAI_API_KEY in Coolify (keep it out of git!)

VERSION=0.2.1

# ===========================================
# APPLICATION SETTINGS
# ===========================================
APP_ENV=production
NODE_ENV=production
REMIX_APP_PORT=3033

# UPDATE THESE with your Coolify domain
# Example: core-xxxxx.91.98.135.237.sslip.io
CORE_APP_ORIGIN=https://PLACEHOLDER_DOMAIN
CORE_LOGIN_ORIGIN=https://PLACEHOLDER_DOMAIN
API_BASE_URL=https://PLACEHOLDER_DOMAIN

# ===========================================
# SECRETS (generate new ones for production!)
# Run: openssl rand -hex 16
# ===========================================
SESSION_SECRET=GENERATE_NEW_SECRET
ENCRYPTION_KEY=GENERATE_NEW_SECRET
MAGIC_LINK_SECRET=GENERATE_NEW_SECRET

# ===========================================
# POSTGRESQL DATABASE
# ===========================================
DB_HOST=core-postgres
DB_PORT=5432
POSTGRES_USER=core
POSTGRES_PASSWORD=GENERATE_NEW_SECRET
POSTGRES_DB=core

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}?schema=core
DIRECT_URL=${DATABASE_URL}

# ===========================================
# NEO4J GRAPH DATABASE
# ===========================================
NEO4J_URI=bolt://core-neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=GENERATE_NEW_SECRET
NEO4J_AUTH=neo4j/SAME_AS_NEO4J_PASSWORD

# ===========================================
# REDIS CACHE
# ===========================================
REDIS_HOST=core-redis
REDIS_PORT=6379
REDIS_TLS_DISABLED=true

# ===========================================
# AI PROVIDER (Required!)
# ===========================================
# ADD IN COOLIFY UI - DO NOT COMMIT TO GIT
OPENAI_API_KEY=

# Model settings
MODEL=gpt-4.1-2025-04-14
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_SIZE=1536
MODEL_PROVIDER=vercel-ai

OLLAMA_URL=

# ===========================================
# AUTHENTICATION
# ===========================================
ENABLE_EMAIL_LOGIN=true

AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# ===========================================
# BACKGROUND JOBS
# ===========================================
QUEUE_PROVIDER=bullmq

# ===========================================
# DATA PROVIDERS
# ===========================================
GRAPH_PROVIDER=neo4j
VECTOR_PROVIDER=pgvector

# ===========================================
# TELEMETRY (disabled for self-hosted)
# ===========================================
TELEMETRY_ENABLED=false
TELEMETRY_ANONYMOUS=true
POSTHOG_PROJECT_KEY=